use cp30725_wrt;

SET SQL_SAFE_UPDATES = 0;

drop table player_profile;

create table player_profile
( player varchar(50),
 total_wins integer,
 tourney_wins integer,
 country varchar(100),
 hometown varchar(100),
 current_residence varchar(100),
 height varchar(10),
 weight varchar(4),
 college varchar(50),
 sponsor varchar(50),
 dob varchar(10),
 l_r_flag varchar(1),
 current_age integer,
 notes varchar(255),
 tmp_dob date);

select * from player_profile;

create table player_profile_20170221 as select * from player_profile;

truncate table player_profile;


load data local infile 'D:/Dropbox/z rball/WRT/wrt_player_profile.csv' into table player_profile
fields terminated by ',' enclosed by '"' lines terminated by '\n';

select * from player_profile;

delete from player_profile where player='Player';

delete from player_profile where player=' ';

delete from player_profile where player='';

commit;


-- fix tmp_dates

/*
